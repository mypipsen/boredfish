enum MediaType {
  movie
  tv
}

enum UserMediaStatus {
  watchlist
  archived
}

model Media {
  id          Int         @id
  title       String
  description String
  year        String
  poster      String
  type        MediaType
  rating      Float
  releaseDate DateTime
  createdAt   DateTime    @default(now())
  userMedia   UserMedia[]

  @@map("media")
}

model UserMedia {
  user      User            @relation(fields: [userId], references: [id])
  userId    String
  media     Media           @relation(fields: [mediaId], references: [id])
  mediaId   Int
  status    UserMediaStatus
  liked     Boolean?
  createdAt DateTime        @default(now())

  @@id([userId, mediaId])
  @@map("user_media")
}
